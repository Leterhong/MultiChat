{
  "name": "multichat-backend",
  "version": "1.5.2",
  "private": true,
  "type": "commonjs",
  "description": "MultiChat backend — Express-based multi-model Agent platform",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "lint": "eslint . --ext .ts,.cjs --max-warnings 99999",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
