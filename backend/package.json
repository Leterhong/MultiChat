{
  "name": "multichat-backend",
  "version": "1.0.0",
  "private": true,
  "description": "MultiChat backend — Express-based multi-model Agent platform",
  "main": "server.ts",
  "scripts": {
    "start": "node -r ./lib/tsx-windows-shim.cjs --import tsx server.ts",
    "dev": "node --watch -r ./lib/tsx-windows-shim.cjs --import tsx server.ts",
    "test": "node -r ./lib/tsx-windows-shim.cjs --import tsx --test tests/*.test.ts",
    "lint": "eslint . --ext .ts,.cjs --max-warnings 99999",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "adm-zip": "^0.5.18",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "eslint": "^8.57.1",
    "typescript": "^5.6.3"
  }
}
