# ====== 服务配置 ======
PORT=3000

# ====== ClawTip 官方配置（登录 clawtip.jd.com 后台获取） ======
# 收款钱包地址（你的商户 ID）
CLAWTIP_PAY_TO=your_pay_to_id_here
# SM4 加密密钥（16 字节）
CLAWTIP_SM4_KEY=your_sm4_key_here
# 技能版本号
CLAWTIP_SKILL_VERSION=1.0.12
# 技能 slug 名称（用于 indicator 生成，如 'my-awesome-skill'）
CLAWTIP_SKILL_SLUG=my-awesome-skill

# ====== 回调配置 ======
# ClawTip 异步通知回调地址（公网可访问）
CLAWTIP_CALLBACK_URL=http://localhost:3000/api/clawtip/callback

# ====== 跨域配置 ======
# 允许的前端域名（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
